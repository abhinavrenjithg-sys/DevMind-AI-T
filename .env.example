# DevMind AI Configuration

# Database
# Local development default: sqlite+aiosqlite:///storage/devmind.db
# PostgreSQL docker default: postgresql+asyncpg://devmind:devmind_secure_password@localhost:5432/devmind
DATABASE_URL=sqlite+aiosqlite:///storage/devmind.db

# Storage & Ingestion Limits
MAX_ARCHIVE_SIZE_BYTES=104857600
MAX_FILE_SIZE_BYTES=10485760
MAX_FILE_COUNT=10000

# AI Provider Configuration
# Supported options: heuristic, openai, gemini, anthropic
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Server Ports
BACKEND_PORT=8088
FRONTEND_PORT=5173
